# {{ ansible_managed }}
apiVersion: helm.cattle.io/v1
kind: HelmChartConfig
metadata:
  name: rke2-cilium
  namespace: kube-system
spec:
  valuesContent: |-
    kubeProxyReplacement: true
    k8sServiceHost: localhost        # RKE2-Supervisor-LB auf jedem Node
    k8sServicePort: 6443
    devices: {{ rke2_iface }}
    l2announcements:
      enabled: true
    externalIPs:
      enabled: true
    k8sClientRateLimit:              # L2-Leases brauchen API-Budget
      qps: 20
      burst: 40
    gatewayAPI:
      enabled: true
      gatewayClass:
        create: "{{ cilium_gateway_class_create }}"
    operator:
      replicas: 2
      rollOutPods: true
    rollOutCiliumPods: true
