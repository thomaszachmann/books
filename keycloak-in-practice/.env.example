# Copy to .env before starting anything. Chapter 2, Step 2.
#
# Versions come from VERSIONS.md; these are the values that differ
# between one reader's laptop and another's.

# The bootstrap administrator. Chapter 3 explains why this is temporary
# and Exercise 3.4 removes it.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me-before-chapter-3

# PostgreSQL. Chapter 19 replaces this with a credential Vault issues.
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=change-me-too

# The directory server's Administrator password. Samba enforces a
# complexity policy; a short password fails at provisioning time with a
# message that does not mention the policy.
AD_ADMIN_PASSWORD=Meridian-Lab-2026

# Ports published on your laptop. Change only if something else holds
# them; the book assumes these.
KC_HTTPS_PORT=443
KC_MGMT_PORT=9000
